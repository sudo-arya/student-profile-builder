<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>{{ profile.name }}</title><link rel="stylesheet" href="./assets/template/style.css"></head><body><aside><h1>{{ profile.name }}</h1><p>{{ profile.designation }}</p><nav><a href="#profile">Profile</a>{% for section in sections %}<a href="#{{ section.id }}">{{ section.title }}</a>{% endfor %}</nav></aside><main><section id="profile"><h2>Profile</h2><p>{{ profile.department }}{% if profile.department %}, {% endif %}{{ profile.institute }}</p>{% if profile.research_interests %}<ul>{% for item in profile.research_interests %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}</section>{% for section in sections %}<section id="{{ section.id }}"><h2>{{ section.title }}</h2>{{ section.html|safe }}</section>{% endfor %}</main></body></html>
