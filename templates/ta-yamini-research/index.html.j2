<!doctype html>
<html lang="en" data-theme="{{ theme.default if theme.default != 'system' else 'light' }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Academic profile of {{ profile.name }}"><title>{{ profile.name }} — Research Portfolio</title>
  {% if theme.enabled %}<script>(function(){try{var s=localStorage.getItem('profile-theme'),d={{ theme.default|tojson }},v=s||d;if(v==='system')v=matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';document.documentElement.dataset.theme=v}catch(e){}})()</script>{% endif %}
  <link rel="stylesheet" href="./assets/template/style.css"><link rel="stylesheet" href="./assets/template/extra.css"><link rel="stylesheet" href="./assets/template/semantic.css"><link rel="stylesheet" href="./assets/template/bottom.css">
</head><body>
  <header class="site-header"><div class="wrap">
    <a href="#top" class="brand" title="{{ profile.name }}"><span class="bracket">⟨</span>{{ profile.name.split()[-2][0] }}. {{ profile.name.split()[-1] }}<span class="bracket">⟩</span></a>
    <nav class="nav-desktop" aria-label="Primary"><a href="#about">About</a><a href="#current-research">Research</a><a href="#education">Career</a><a href="#publications">Publications</a><a href="#projects">Projects</a><a href="#skills">Skills</a><a href="#contact">Contact</a></nav>
    <div class="header-right">{% if theme.enabled %}<div class="theme-toggle" role="group" aria-label="Theme"><button type="button" data-theme-choice="light" aria-label="Light theme">☀</button><button type="button" data-theme-choice="dark" aria-label="Dark theme">☾</button></div>{% endif %}<button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false">☰</button></div>
  </div>{% if sections %}<nav class="nav-mobile" aria-label="Mobile">{% for s in sections %}<a href="#{{ s.id }}">{{ s.title }}</a>{% endfor %}</nav>{% endif %}</header>
  <main><section id="top" class="hero" style="border-top:none"><div class="wrap"><div class="hero-grid"><div>
    <p class="hero-eyebrow"><span class="bracket">±</span> {{ profile.designation }} · {{ profile.institute }}</p>
    <h1>{{ profile.name.split()[-2] }} <em>{{ profile.name.split()[-1] }}</em></h1>
    <p class="hero-role">{{ profile.designation }}{% if profile.department %}, {{ profile.department }}{% endif %}.{% if profile.research_interests %} Working on <strong>{{ profile.research_interests|join(', ') }}</strong> — building systems people can understand, question, and confidently use.{% endif %}</p>
    {% if profile.research_interests %}<div class="hero-tags">{% for i in profile.research_interests %}<span class="hero-tag">{{ i }}</span>{% endfor %}</div>{% endif %}
    <div class="hero-links">{% if profile.email %}<a href="mailto:{{ profile.email }}">{{ profile.email }}</a>{% endif %}{% for label,url in profile.links.items() if url %}<a href="{{ url }}" target="_blank" rel="noopener noreferrer">{{ label|replace('_',' ')|title }} ↗</a>{% endfor %}{% if profile.cv %}<a href="{{ profile.cv }}" target="_blank" rel="noopener">Resume ↗</a>{% endif %}</div>
    </div>{% if profile.photo and 'profile-placeholder.svg' not in profile.photo %}<div class="hero-portrait"><span class="corner"></span><img src="{{ profile.photo }}" alt="Portrait of {{ profile.name }}"></div>{% else %}<div class="hero-portrait fallback"><span class="corner"></span>{{ profile.name.split()[-2:]|map('first')|join('')|upper }}</div>{% endif %}</div><div id="hero-stats" class="stat-strip"></div></div>
  </section>
  {% set experience_items=sections|selectattr('type','equalto','experience')|list %}{% set experience=experience_items[0] if experience_items else none %}{% set counter=namespace(value=0) %}
  {% for s in sections if s.type != 'experience' %}{% set counter.value=counter.value+1 %}<section id="{{ s.id }}" data-section-type="{{ s.type }}"><div class="wrap"><div class="axis" aria-hidden="true"><div class="section-index"><span class="index-num mono">{{ '%02d'|format(counter.value) }}</span><span class="section-label">{{ s.title }}</span></div><span class="axis-line"></span></div>{% if s.type == 'education' %}<div class="section-body career-body rail" data-reveal><div class="markdown-body">{{ s.html|safe }}</div>{% if experience %}<div class="markdown-body">{{ experience.html|safe }}</div>{% endif %}</div>{% else %}<div class="section-body markdown-body" data-reveal>{{ s.html|safe }}</div>{% endif %}</div></section>{% endfor %}</main>
  <footer class="site-footer wrap"><span class="fnote">© {{ site.generated_at[:4] }} {{ profile.name }}</span><a href="#top" class="fnote">Back to top ↑</a></footer>
  <script src="./assets/template/main.js" defer></script><script src="./assets/template/structure.js" defer></script><script src="./assets/template/presentation.js" defer></script>
</body></html>
